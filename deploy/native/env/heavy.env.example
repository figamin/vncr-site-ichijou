# VN Club heavy-job settings for a native host.
#
# Installed as /etc/vnclub/heavy.env (mode 640 root:vnclub) and read by
# vnclub-heavy.service on top of api.env, which supplies DATABASE_URL,
# REDIS_URL, DUMP_STORAGE_PATH and the VNDB token.
#
# HEAVY_MODE selects where the job runs:
#   local  - on this host, using the local .venv (single-host installs)
#   remote - over SSH with remote port forwards (two-host installs)
#   auto   - remote when HEAVY_SSH_HOST is set, otherwise local
#
# The defaults below are the single-host setup described in
# deploy/native/SINGLE_HOST_ARM64.md.

HEAVY_MODE=local

# daily          full import + model/similarity rebuild + leaderboards
# similarity     model/similarity rebuild only
# leaderboards   leaderboard rebuild only
HEAVY_TASK=daily

HEAVY_WORKDIR=/srv/vnclub/vndb-stats-backend
HEAVY_PYTHON=.venv/bin/python
HEAVY_TASK_SCRIPT=/srv/vnclub/deploy/native/scripts/heavy_task.py

# --- Remote mode only --------------------------------------------------------
# Set HEAVY_MODE=remote (or leave HEAVY_MODE=auto and set this) to run the job
# on another machine. The remote host must have the same checkout, venv and
# /etc/vnclub/heavy.env (see heavy.worker.example), and must be reachable with
# a batch-mode SSH key as the vnclub user.
# HEAVY_SSH_HOST=vnclub@worker.example.com
