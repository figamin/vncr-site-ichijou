# VN Club FastAPI environment for a native (Docker-free) host.
#
# Installed by prepare-app.sh as /etc/vnclub/api.env (mode 640 root:vnclub).
# Read by vnclub-api.service, vnclub-bot.service and, in local heavy mode, by
# vnclub-heavy.service.
#
# Values that contain JSON (CORS_ORIGINS) must stay on one line.

# --- Application -------------------------------------------------------------
DEBUG=false
# Keep DEV_MODE=false on a served instance: it disables the weak-password check
# and stops the worker from triggering imports on its own.
DEV_MODE=false
APP_NAME=VNDB Stats API
# Swagger at /docs. Leave false unless you want the schema public.
ENABLE_API_DOCS=false

# --- Database ----------------------------------------------------------------
# Single host: PostgreSQL listens on loopback only.
DATABASE_URL=postgresql+asyncpg://vndb:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/vndb_stats
# One API worker plus the nightly heavy job. Keep the pool small: PostgreSQL's
# max_connections in deploy/native/postgres/tuning*.conf is sized for this.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0
CACHE_TTL_SECONDS=600

# --- VNDB API ----------------------------------------------------------------
VNDB_API_URL=https://api.vndb.org/kana
# Required for /stats/<username> lookups. https://vndb.org/p/all (API tokens).
VNDB_API_TOKEN=
VNDB_RATE_LIMIT_REQUESTS=200
VNDB_RATE_LIMIT_WINDOW=300

# --- Local storage -----------------------------------------------------------
# VNDB dumps are downloaded here by the heavy job.
DUMP_STORAGE_PATH=/srv/vnclub/dumps
# WebP covers, generated on demand and served directly by Angie.
VNDB_CACHE_DIR=/srv/vnclub/public/vndb-images

# --- Web front end -----------------------------------------------------------
# Public URL of the site. Used in Discord embeds and cache-refresh buttons.
FRONTEND_URL=https://vnclub.example.com
# Browser origins allowed to call the API. Comma-separated. A JSON array is
# also accepted, but systemd's environment-file parser can strip the quotes
# inside it, so the plain form is safer here. The site calls its own
# /api/backend proxy, so this only needs the site origin (plus extras).
CORS_ORIGINS=https://vnclub.example.com

# Must match the same value in web.env. Generate with: openssl rand -hex 32
BLACKLIST_REFRESH_SECRET=

# --- Optional features -------------------------------------------------------
# Admin endpoints (/admin/*, /logs/*). Generate with: openssl rand -hex 32
ADMIN_API_KEY=
# Cloudflare Turnstile for /shared submissions. Set both halves or neither.
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_OPEN=false
# Discord bot (Ichijou). Leave empty to not run it.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USER_IDS=
DISCORD_LOG_WEBHOOK_URL=
# TMDB token, used by film-night search.
TMDB_API_KEY=
# Hikaru calendar import (same-host SQLite). Leave empty to disable.
HIKARU_DATA_DIR=
VNCR_GUILD_ID=

# --- Heavy job ---------------------------------------------------------------
# Full import and model-rebuild budget, in seconds. Keep below the heavy unit's
# TimeoutStartSec (26h).
FULL_IMPORT_TIMEOUT=86400
# Recommendation engine knobs (defaults are fine for a normal install).
CF_FACTORS=64
CF_ITERATIONS=50
CF_REGULARIZATION=0.1
TAG_WEIGHT=0.4
CF_WEIGHT=0.6
