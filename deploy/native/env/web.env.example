# VN Club Next.js environment for a native (Docker-free) host.
#
# Installed by prepare-app.sh as /etc/vnclub/web.env (mode 640 root:vnclub)
# and read by vnclub-web.service.
#
# NEXT_PUBLIC_* values are baked into the client bundle at build time. This
# layout calls the API through the same-origin /api/backend proxy, so no public
# backend URL is required and none needs to be exported before `bun run build`.

NODE_ENV=production
PORT=3000
# Loopback only; Angie proxies to it.
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# Server-side API base used by the /api/backend and /api/proxy-image routes.
API_URL_INTERNAL=http://127.0.0.1:8000

# Covers are written here by the image route and read directly by Angie.
VNDB_CACHE_DIR=/srv/vnclub/public/vndb-images

# Must match the API value, or blacklist refreshes are rejected.
BLACKLIST_REFRESH_SECRET=

# Optional analytics (only if you run Umami yourself). Changing these requires
# a frontend rebuild, because they are compiled into the client bundle.
# NEXT_PUBLIC_UMAMI_URL=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
