[Unit]
Description=VN Club PostgreSQL backup
Documentation=file:///srv/vnclub/deploy/native/SETUP.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/srv/vnclub/deploy/native/scripts/backup.sh
# A compressed dump of the multi-GiB database can exceed systemd's 90s default.
TimeoutStartSec=1h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/vnclub
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
