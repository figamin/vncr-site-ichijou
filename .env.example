# VN Club Frontend Environment Variables
# Copy this to .env.local for local development

# ===========================================
# Required: Backend API URL
# ===========================================
# URL of the VNDB Stats backend API
# Local development: http://localhost:8000
# Production (Railway): https://your-backend.railway.app
NEXT_PUBLIC_VNDB_STATS_API=http://localhost:8000

# Alternative API URL (optional, defaults to NEXT_PUBLIC_VNDB_STATS_API)
NEXT_PUBLIC_API_URL=http://localhost:8000

# News API URL (optional, defaults to NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_NEWS_API_URL=http://localhost:8000

# Dev-only: extra origins (hostnames/IPs) the dev server may serve to, beyond
# localhost. Comma-separated. See Next.js allowedDevOrigins.
# ALLOWED_DEV_ORIGINS=

# ===========================================
# Blacklist Cache Refresh
# ===========================================
# Secret token for the Discord bot to trigger cache refresh
# Generate with: openssl rand -hex 32
# BLACKLIST_REFRESH_SECRET=your-secret-here

# ===========================================
# VNDB Image Cache
# ===========================================
# Directory for VNDB images (covers, screenshots, etc.).
# Keep this inside the site tree so Angie can serve /img/ directly:
#   VNDB_CACHE_DIR=/absolute/path/to/project/public/vndb-images
# If unset, the image scripts fall back to ~/.vnclub/vndb-cache, while
# `bun run dev`/`bun run prod` defaults to public/vndb-images.
# Docker uses /app/public/vndb-images (bind-mounted from ./public/vndb-images).
# VNDB_CACHE_DIR=

# ===========================================
# Cloudflare Turnstile (bot protection for share links)
# ===========================================
# Site key from Cloudflare dashboard > Turnstile > Add widget
# Leave unset in development — share links work without it
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ===========================================
# Build Options
# ===========================================
# Set to 'true' for static export (GitHub Pages)
# Leave unset or 'false' for standalone output (Railway/Docker)
# STATIC_EXPORT=true
